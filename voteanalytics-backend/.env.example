# VoteAnalytics Backend: Environment Variables Template
# Copy this file to .env or set environment variables in your deployment environment

# Database Configuration (MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/voteanalytics_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Security & JWT Secrets (Replace with a 64+ char random hex string in production)
JWT_SECRET=9a4f2c8d3b7a1e6f4c8b2d0e5a7f9c1b3d5e7a9c1b3d5e7a9c1b3d5e7a9c1b3d
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend URL (For email verification and poll links)
FRONTEND_URL=http://localhost:5173

# SMTP Mail Server Configuration (e.g. Gmail, Mailgun, SendGrid SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@voteanalytics.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM=noreply@voteanalytics.com
